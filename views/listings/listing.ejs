<% layout('layouts/boilerplate.ejs') -%>
<script>
    const coordinates=<%-JSON.stringify(listing.geometry.coordinates)%>;
</script>
        <div class="row">
            <div class="d-flex justify-content-center align-items-center">
                <h1 class="text-center">
                    <%=listing.title%>
                </h1>
            </div>
            <div>
                <div class="card col-6 offset-3 mt-3 listing-card">
                    <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="Listing-image">
                    <div class="card-body">
                        <p class="card-text"><i>Owned by <%=listing.owner.username%></i></p>

                        <p class="card-text"><%=listing.description%></p>
                        <p class="card-text">&#8377;<%=listing.price.toLocaleString("en-IN")%></p>
                        <p class="card-text"><%=listing.location%></p>
                        <p class="card-text"><%=listing.country%></p>
                    </div>
                </div>
                <%if(currUser&&currUser._id.equals(listing.owner._id)){%>
                    <div class="btns offset-3">
                        <div>
                            <a href="/listings/<%=listing.id %>/edit" class="btn edit-btn">Edit</a>
                        </div>
                        <div>
                            <form action="/listings/<%=listing.id%>?_method=DELETE" method="POST">
                                <Button class="btn del-btn">Delete</Button>
                            </form>
                        </div>
                    </div>
                <%}%>
                <br>
                <%if(currUser){%>
                    <div class="col-8 offset-3">
                        <h4>Leave a Review</h4>
                        <form action="/listings/<%=listing.id%>/reviews" method="POST">
                            <div>
                                <label for="rating" class="form-label">Rating</label>
                                <fieldset class="starability-heartbeat">
                                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                    <label for="first-rate1" title="Terrible">1 star</label>
                                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                    <label for="first-rate2" title="Not good">2 stars</label>
                                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                    <label for="first-rate3" title="Average">3 stars</label>
                                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                    <label for="first-rate4" title="Very good">4 stars</label>
                                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                    <label for="first-rate5" title="Amazing">5 stars</label>
                                </fieldset>
                            </div>
                            <div>
                                <label for="comment">Comments</label>
                                <br>
                                <textarea required name="review[comment]" id="comment" name="review[comment]" cols="30"
                                    rows="10" class="form-control"></textarea>
                                <br>
                            </div>
                            <button class="btn btn-outline-dark">Submit</button>
                        </form>
                        <br><br>
                    </div>
                <%}%>
                <%if(listing.reviews.length>0){%>
                    <div class="row col-8 offset-3">
                        <h4 style="text-align: center;">All Reviews</h4>
                        <hr>
                        <%for(review of listing.reviews){%>
                            <div class="card col-5 ms-3 mb-3">
                                <div class="card-body p-3">
                                    <h5 class="card-title mb-2"><%=review.author.username%></h5>
                                    <p class="starability-result card-text mb-2" data-rating=<%=review.rating%>>
                                        <%=review.rating%>
                                    </p>
                                    <div class="card-text mb-2"><%=review.comment%></div>
                                </div>
                                <form action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE"
                                    class="pb-3 px-3" method="POST">
                                    <button class="btn btn-sm btn-dark">Delete</button>
                                </form>
                            </div>
                        <%}%>
                    </div>
                <%}%>
                <br>
                <div class="row justify-content-center">
                    <div class="col-12 text-center">
                        <h4>Where You'll be</h4>
                        <div id="map"></div>
                    </div>
                </div>
                <br><br><br>
            </div>
        </div>