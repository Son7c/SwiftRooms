<% layout('layouts/boilerplate.ejs') -%>

    <body>
        <div class="row">
            <div class="col-6 offset-3">
                <form action="/listings" method="POST" class="needs-validation" novalidate enctype="multipart/form-data">
                    <h1>Create New Listing</h1>

                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input type="text" placeholder="Title" name="listing[title]" class="form-control" required>
                        <div class="valid-feedback">
                            Looks good!
                        </div>
                        <div class="invalid-feedback">
                            Title must be valid
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea name="listing[description]" placeholder="Description" class="form-control"
                            required></textarea>
                        <div class="valid-feedback">
                            Looks good!
                        </div>
                        <div class="invalid-feedback">
                            Description must be valid
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="image" class="form-label">Upload Listing Image</label>
                        <input name="listing[images]" type="file" class="form-control" required>
                    </div>
                    
                    <div class="row">
                        <div class="mb-3 col-md-4">
                            <label for="price" class="form-label">Price</label>
                            <input type="number" name="listing[price]" placeholder="price" class="form-control"
                                required>
                            <div class="valid-feedback">
                                Looks good!
                            </div>
                            <div class="invalid-feedback">
                                Price must be valid
                            </div>
                        </div>
                        <div class="mb-3 col-md-8">
                            <label for="location" class="form-label">Location</label>
                            <input type="text" name="listing[location]" placeholder="location" class="form-control"
                                required>
                            <div class="valid-feedback">
                                Looks good!
                            </div>
                            <div class="invalid-feedback">
                                Location must be valid
                            </div>
                        </div>
                    </div>
                    <label for="country" class="form-label">Country</label>
                    <input type="text" name="listing[country]" placeholder="country" class="form-control" required>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                    <div class="invalid-feedback">
                        Country must be valid
                    </div>
                    <br> <br>
                    <button class="btn add-btn">Add</button>
                </form>
            </div>
        </div>
    </body>